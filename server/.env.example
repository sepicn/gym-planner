PORT=3001
BASE_URL=http://localhost:3001

# Postgres connection string
DATABASE_URL=

# OpenRouter API key used for plan generation
OPEN_ROUTER_KEY=

# Neon Auth base URL - the same value as VITE_NEON_AUTH_URL in the web .env.
# The API verifies session tokens against <NEON_AUTH_URL>/.well-known/jwks.json
NEON_AUTH_URL=

# Optional. Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Optional. Set to the JWT `iss`/`aud` claim to tighten token verification.
NEON_AUTH_ISSUER=

# Optional. Comma-separated OpenRouter models, tried in order.
AI_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
