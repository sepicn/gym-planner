# Everything prefixed with VITE_ is inlined into the browser bundle.
# Never put a secret here - only values that are safe to make public.

# Base URL of the Express API in server/
VITE_API_URL=http://localhost:3001

# Neon Auth base URL for this project.
# Must match NEON_AUTH_URL in server/.env, which verifies tokens against it.
VITE_NEON_AUTH_URL=
